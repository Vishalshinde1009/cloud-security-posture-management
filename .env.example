# ==============================================================================
# Cloud Security Posture Management (CSPM) Platform - Environment Variables
# COPY THIS FILE TO .env AND POPULATE WITH REAL VALUES
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Operation Mode: 'mock' (safe offline demo/testing) or 'aws' (live read-only AWS API scan)
CSPM_MODE=mock

# Security & Authentication
# Generate a strong 64-char hex secret in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin User Credentials (used on initial seed only)
INITIAL_ADMIN_EMAIL=admin@cspm-security.local
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!

# Database Configuration
# For local development without Docker: sqlite:///./cspm.db
# For PostgreSQL (Docker or local): postgresql+psycopg2://cspm_user:cspm_password@localhost:5432/cspm_db
DATABASE_URL=sqlite:///./cspm.db

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AWS Credentials (ONLY REQUIRED WHEN CSPM_MODE=aws)
# Leave blank when CSPM_MODE=mock or when using IAM Instance Profiles / AWS SSO
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ASSUME_ROLE_ARN=

# Risk Scoring Thresholds
RISK_THRESHOLD_CRITICAL=90
RISK_THRESHOLD_HIGH=70
RISK_THRESHOLD_MEDIUM=40
RISK_THRESHOLD_LOW=0
